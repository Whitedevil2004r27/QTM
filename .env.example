# ─── QTM Minerals Corporate Environment Variables ─────────────────────────
# Copy this file to .env.local for local testing and set in your Vercel Dashboard

# 1. Base URL for SEO canonical tags, sitemap, and OpenGraph images
NEXT_PUBLIC_SITE_URL=https://qtmminerals.com

# 2. Email Delivery Gateway (Resend)
# Create a free account at https://resend.com and obtain an API key
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=sales@qtmminerals.com
CONTACT_FROM_EMAIL=inquiries@qtmminerals.com

# 3. CRM / Webhook Integration (Optional Alternative to Resend)
# If set, form submissions will be POSTed as JSON to this endpoint (Zapier, HubSpot, Make, Slack)
# CRM_WEBHOOK_URL=https://api.example.com/webhooks/qtm-inquiries
